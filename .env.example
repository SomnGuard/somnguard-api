# SomnGuard API - Environment Variables Example
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env FILES TO VERSION CONTROL

# ==========================================
# Application
# ==========================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# Database (PostgreSQL) - Assumes DB is running on host
# ==========================================
# Use host.docker.internal on Mac/Windows, or localhost on Linux with --network host
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/somnguard
POSTGRES_USER=somnguard_user
POSTGRES_PASSWORD=changeme
# ==========================================
# JWT Keys (RSA 2048)
# ==========================================
# Dev keys are in src/main/resources/keys/dev/
JWT_PUBLIC_KEY_PATH=classpath:keys/dev/public.pem
JWT_PRIVATE_KEY_PATH=classpath:keys/dev/private.pem

# ==========================================
# Mail (Brevo SMTP) - Ejemplo
# ==========================================
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=tu-login@smtp-brevo.com
MAIL_PASSWORD=tu_smtp_key_aqui
MAIL_FROM=tu-remitente@tu-dominio.com
MAIL_FROM_NAME=SomnGuard

# ==========================================
# Liquibase
# ==========================================
LIQUIBASE_CONTEXTS=dev
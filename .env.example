# SomnGuard API - Environment Configuration Template
# Copy this file to .env.develop, .env.qa, .env.main and fill in real values
# NEVER commit real credentials to git!

# =============================================================================
# Application
# =============================================================================
SPRING_PROFILES_ACTIVE=develop
SERVER_PORT=8080

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=somnguard
DB_USER=somnguard
DB_PASSWORD=changeme_dev_only

# =============================================================================
# Liquibase
# =============================================================================
LIQUIBASE_CONTEXTS=
LIQUIBASE_LABELS=

# =============================================================================
# JWT Authentication (RS256)
# Generate keys with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# =============================================================================
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# =============================================================================
# Multimedia Storage
# =============================================================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage
# STORAGE_TYPE=s3
# STORAGE_S3_BUCKET=somnguard-media
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=

# =============================================================================
# Device API Keys
# =============================================================================
# Device API keys are stored hashed in database, configured per device

# =============================================================================
# Observability (optional)
# =============================================================================
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=somnguard-api
# SomnGuard API - Environment Variables Example
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env FILES TO VERSION CONTROL

# ==========================================
# Application
# ==========================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# Database (PostgreSQL) - Assumes DB is running on host
# ==========================================
# Use host.docker.internal on Mac/Windows, or localhost on Linux with --network host
SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/somnguard
POSTGRES_USER=somnguard_user
POSTGRES_PASSWORD=changeme
# ==========================================
# JWT Keys (RSA 2048)
# ==========================================
# Dev keys are in src/main/resources/keys/dev/
JWT_PUBLIC_KEY_PATH=classpath:keys/dev/public.pem
JWT_PRIVATE_KEY_PATH=classpath:keys/dev/private.pem

# ==========================================
# CORS - Front origins
# ==========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# ==========================================
# Mail - MailHog local (Docker)
# ==========================================
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@somnguard.local
MAIL_FROM_NAME=SomnGuard

# ==========================================
# Password Reset - 6-digit code expiry (minutes)
# ==========================================
PASSWORD_RESET_CODE_EXPIRY_MINUTES=15

# ==========================================
# S3 evidencia (HU-API-007 AC-004, ADR-006)
# Servicio externo en Docker como MailHog (Adobe S3Mock, S3-compatible, in-memory):
#   docker compose up minio  -> API S3 http://localhost:9000 (contenedor: http://minio:9090)
# OJO: S3_ENDPOINT lo consume el contenedor del API, por eso usa el nombre
# del servicio (http://minio:9090); localhost aquí NO funciona (sería el propio contenedor).
# El API crea el bucket somnguard-evidence al arrancar si no existe.
# ==========================================
S3_ENDPOINT=http://minio:9090
S3_REGION=us-east-1
S3_BUCKET=somnguard-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ==========================================
# Liquibase
# ==========================================
LIQUIBASE_CONTEXTS=dev